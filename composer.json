{
    "name": "silverstripe/userdocs-admin",
    "description": "Display user documentation in Silverstripe CMS",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": [
        "silverstripe",
        "documentation",
        "help"
    ],
    "authors": [
        {
            "name": "Silverstripe",
            "homepage": "https://silverstripe.com"
        },
        {
            "name": "The Silverstripe Community",
            "homepage": "https://silverstripe.org"
        }
    ],
    "require": {
        "php": "^8.3",
        "league/commonmark": "^2.10",
        "pomodocs/commonmark-alert": "^0.8",
        "silverstripe/framework": "^6.3",
        "silverstripe/admin": "^3.3",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/standards": "^1",
        "silverstripe/documentation-lint": "^1",
        "phpstan/extension-installer": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "SilverStripe\\UserDocs\\": "src/",
            "SilverStripe\\UserDocs\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "expose": [
            "client/dist",
            "client/images"
        ]
    }
}
