{
  "name": "silverstripe-userdocs-admin",
  "version": "1.0.0",
  "description": "User documentation admin for Silverstripe CMS",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silverstripe/silverstripe-userdocs-admin.git"
  },
  "homepage": "https://github.com/silverstripe/silverstripe-userdocs-admin",
  "bugs": {
