    "@babel/runtime": "^7.20.0",
    "@silverstripe/eslint-config": "^2",
    "@silverstripe/webpack-config": "^3",
    "eslint": "^8.26.0",
    "stylelint": "~16.12.0",
    "webpack": "^5.74.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "bootstrap": "^5.2.0",
    "core-js": "^3.26.0",
    "webpack-sources": "^3.2.3"
  },
  "browserslist": [
    "defaults"
  ]
